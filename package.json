    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
